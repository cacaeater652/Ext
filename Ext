--------------------------------------------------
-- HITBOX
--------------------------------------------------

local function updateHitbox(character)
	if not character then
		return
	end

	local root = character:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end

	local hitbox = character:FindFirstChild("CustomHitbox")

	if not hitbox then
		hitbox = Instance.new("Part")
		hitbox.Name = "CustomHitbox"
		hitbox.Anchored = false
		hitbox.Massless = true
		hitbox.CanCollide = false
		hitbox.CanTouch = true
		hitbox.CanQuery = true
		hitbox.Transparency = 1
		hitbox.Parent = character

		local weld = Instance.new("WeldConstraint")
		weld.Part0 = root
		weld.Part1 = hitbox
		weld.Parent = hitbox
	end

	hitbox.Size = Vector3.new(
		hitboxSize,
		hitboxSize,
		hitboxSize
	)

	hitbox.CFrame = root.CFrame
end
--------------------------------------------------
-- PLAYER SETUP
--------------------------------------------------

local function setupPlayer(player)
	if player == LocalPlayer then
		return
	end

	if player.Character then
		updateHitbox(player.Character)
	end

	player.CharacterAdded:Connect(function(character)
		character:WaitForChild("HumanoidRootPart", 5)

		task.wait(0.2)

		updateHitbox(character)
	end)
end

for _, player in ipairs(Players:GetPlayers()) do
	setupPlayer(player)
end

Players.PlayerAdded:Connect(setupPlayer)

--------------------------------------------------
-- CHANGE HITBOX SIZE
--------------------------------------------------

input.FocusLost:Connect(function()
	local number = tonumber(input.Text)

	if number then
		number = math.clamp(number, 1, 100)

		hitboxSize = number

		input.Text = tostring(hitboxSize)
		status.Text = "Current: " .. hitboxSize

		-- Update everyone immediately
		for _, player in ipairs(Players:GetPlayers()) do
			if player ~= LocalPlayer and player.Character then
				updateHitbox(player.Character)
			end
		end
	else
		input.Text = tostring(hitboxSize)
	end
end)
